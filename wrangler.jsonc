{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valennet-solutions",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valennet-production",
      "database_id": "9d0d3bd8-c15d-46c5-b586-f5efcd269bb0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "valennet-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
